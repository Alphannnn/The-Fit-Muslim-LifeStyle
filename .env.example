# Copy to .env.local and fill in. Everything here is optional for local
# development: with no values at all the app runs against .data/tfm.db, settles
# checkout through a clearly-labelled test page, and writes email to a table.

# --- Database (required in production) -------------------------------------
# Turso (libSQL) — the same SQLite engine over HTTP, so a serverless host can
# use it. Create one with the Turso CLI or app.turso.tech, then point the
# schema push and the seed at it:  pnpm db:push && pnpm db:seed
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Local development only: a file database is used when the two above are unset.
# DATABASE_FILE=.data/tfm.db

# --- Site ------------------------------------------------------------------
# Canonical URLs, sitemap, staff invitation links and Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# --- Seeding ---------------------------------------------------------------
# Read only while `pnpm db:seed` creates the staff accounts on an empty
# database. Set real values before seeding anything reachable from the internet.
SEED_ADMIN_PASSWORD=
SEED_COACH_PASSWORD=

# --- Payments (optional) ---------------------------------------------------
# Without a secret key the checkout settles through the test page instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TAX_RATE_BPS=0

# --- Email (optional) ------------------------------------------------------
# Without a key every send is written to the email_log table and the console.
RESEND_API_KEY=
MAIL_FROM="The Fit Muslim <hello@yourdomain.com>"
