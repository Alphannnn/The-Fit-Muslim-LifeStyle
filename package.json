{
  "name": "the-fit-muslim-lifestyle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "share": "bash scripts/share.sh",
    "share:stop": "bash scripts/share.sh stop",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "mkdir -p .data && drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx lib/db/seed.ts",
    "db:reset": "rm -rf .data/tfm.db* && pnpm db:push && pnpm db:seed",
    "setup": "pnpm db:push && pnpm db:seed",
    "admin:invite": "tsx scripts/admin-invite.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.15.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
